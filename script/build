#!/usr/bin/env bash
set -e

export APP=${1:?"app name is required"}
export VERSION=${2:?"version is required"}
BUILD_DIR=./build

rm -f "$BUILD_DIR/$APP"
mkdir -p "$BUILD_DIR"
VERSION=$VERSION goop go install -x -ldflags "-X main.version ${VERSION}" -v ./...
BUILD_DIR=$BUILD_DIR goop exec bash -c 'cp $GOBIN/$APP $BUILD_DIR/$APP'
