#!/usr/bin/env bash
# create .deb file for ferry
#
# This requires the binary to be built and placed into ./build

PKGNAME="ferry"
PKGVERSION="$1"
PACKAGE_URL="http://nitrous.io/"
PACKAGE_ARCHITECTURE="$(dpkg-architecture -qDEB_HOST_ARCH)"
PACKAGE_DESCRIPTION="Nitrous.IO HTTP proxy for boxhost"
PACKAGE_LICENSE="Private"

BUILD=$WORKDIR/build # where we store ferry binary
FILES=$WORKDIR/files/$PKGNAME # where we store configuration files
PKGDIR=/opt/$PKGNAME/build # /opt/ferry/build is mapped to $HOME/build on the host

echo "PKGDIR: $PKGDIR"

bundle() {
  rm -rf $PKGDIR
  mkdir -p $PKGDIR

  # install our ferry configuration
  install -m 0644 -D $FILES/data/etc/init/ferry.conf $PKGDIR/etc/init/ferry.conf

  # install our nginx configuration
  ruby $FILES/data/etc/nginx/conf.d/ferry.rb $FILES/data/etc/nginx/conf.d/ferry.conf
  install -m 0644 -D $FILES/data/etc/nginx/conf.d/ferry.conf $PKGDIR/etc/nginx/conf.d/ferry.conf

  # install our ferry binary
  install -m 0755 -D $BUILD/ferry $PKGDIR/usr/sbin/ferry

  (
  cd $PKGDIR

  fpm \
    -s dir \
    -C $PKGDIR \
    --name $PKGNAME-$PKGVERSION \
    --version $PKGVERSION \
    --architecture "$PACKAGE_ARCHITECTURE" \
    --prefix / \
    --description "$PACKAGE_DESCRIPTION" \
    --maintainer "$PACKAGE_MAINTAINER" \
    --provides $PKGNAME \
    --replaces $PKGNAME \
    --depends nginx \
    --after-install $FILES/control/postinst \
    --before-remove $FILES/control/prerm \
    --config-files /etc/init/ferry.conf \
    --config-files /etc/nginx/conf.d/ferry.conf \
    --deb-compression gz \
    -t deb .

  fpm -s empty \
    --name $PKGNAME \
    --version $PKGVERSION \
    --architecture "$PACKAGE_ARCHITECTURE" \
    --depends $PKGNAME-$PKGVERSION \
    --description "$PACKAGE_DESCRIPTION" \
    --maintainer "$PACKAGE_MAINTAINER" \
    --url "$PACKAGE_URL" \
    --license "$PACKAGE_LICENSE" \
    --deb-compression gz \
    -t deb
  )

  # cleanup the build directory
  rm -rf $PKGDIR/etc
  rm -rf $PKGDIR/usr
  rm -rf $PKGDIR/var
  rm -rf $PKGDIR/lib
}

bundle
